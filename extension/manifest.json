{
  "manifest_version": 3,
  "name": "Austra ERP - Auto-Rezervācija & Ražošana",
  "version": "1.2.5",
  "description": "Automatizē materiālu rezervēšanu un statusa maiņu Austra ERP ar iebūvētu cenu saskaņošanas statusa drošības pārbaudi.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Austra LPAxxx auto palaidējs (Atvērt/Aizvērt paneli)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "notifications",
    "storage",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://austra.amfurnitura.lv/*",
    "https://raw.githubusercontent.com/kaspars1985/austra23/*",
    "https://api.github.com/repos/kaspars1985/austra23/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://austra.amfurnitura.lv/order_management/orders/*",
        "http://localhost:*/*mock_austra_page.html*",
        "http://127.0.0.1:*/*mock_austra_page.html*",
        "file:///*mock_austra_page.html*"
      ],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
